{
  "version": 1,
  "scratchpad": [
    {
      "app": "herdr",
      "class": "com.mitchellh.ghostty",
      "exec": "omarchy-launch-terminal herdr",
      "note": "ghostty is shared by every terminal; the CLI targets the window it launched, matched by the openwindow event address, not by class"
    }
  ],
  "workspaces": {
    "1": {
      "app": "brave",
      "class": "brave-origin",
      "exec": "brave-origin"
    },
    "2": {
      "split": "columns",
      "ratios": [0.5, 0.5],
      "children": [
        {
          "split": "columns",
          "ratios": [0.5, 0.5],
          "children": [
            { "app": "signal", "class": "signal", "exec": "signal-desktop" },
            { "app": "telegram", "class": "org.telegram.desktop", "exec": "Telegram" }
          ]
        },
        { "app": "discord", "class": "discord", "exec": "discord" }
      ]
    },
    "4": {
      "app": "modrinth",
      "class": "modrinth-app",
      "exec": "modrinth-app",
      "note": "class is a first guess; confirm with `omarchy-layout status` and fix via `omarchy-layout save modrinth`"
    },
    "5": {
      "app": "virt-manager",
      "class": "virt-manager",
      "exec": "virt-manager",
      "note": "class is a first guess; confirm with `omarchy-layout status` and fix via `omarchy-layout save kvm`"
    }
  }
}
